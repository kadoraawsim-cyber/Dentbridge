# Example environment variables for local and deployment setup.
# Real secrets must never be committed.
#
# NEXT_PUBLIC_* variables may be exposed to the browser. Only place values here
# that are safe for client-side use.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_PASSWORD_RESET_REDIRECT_URL=https://example.com/auth/update-password

# Server-side URL configuration planned for Phase 1.
APP_URL=https://example.com
INVITE_REDIRECT_URL=https://example.com/auth/callback

# Server-side secrets.
# OPENAI_API_KEY must be server-side only and must never be exposed to browser code.
OPENAI_API_KEY=your-openai-api-key
# SUPABASE_SERVICE_ROLE_KEY must be server-side only and must never be exposed to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
