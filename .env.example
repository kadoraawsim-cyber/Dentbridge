# Example environment variables for local and deployment setup.
# Real secrets must never be committed.
#
# NEXT_PUBLIC_* variables may be exposed to the browser. Only place values here
# that are safe for client-side use.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_PASSWORD_RESET_REDIRECT_URL=https://example.com/auth/update-password
# UI switch for the patient attachment upload. Must mirror PATIENT_UPLOADS_ENABLED;
# the server enforces the real gate, this only hides the upload form.
NEXT_PUBLIC_PATIENT_UPLOADS_ENABLED=false

# Server-side URL configuration.
APP_URL=https://example.com
INVITE_REDIRECT_URL=https://example.com/auth/callback

# Server-side secrets.
# OPENAI_API_KEY must be server-side only and must never be exposed to browser code.
OPENAI_API_KEY=your-openai-api-key
# SUPABASE_SERVICE_ROLE_KEY must be server-side only and must never be exposed to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Twilio Verify credentials must remain server-side and must never use a
# NEXT_PUBLIC_ prefix. API key authentication is used instead of an auth token.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_API_KEY_SID=your-twilio-api-key-sid
TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid
CRON_SECRET=your-dedicated-cron-secret-at-least-32-characters
RATE_LIMIT_HMAC_SECRET=your-dedicated-rate-limit-hmac-secret-at-least-32-characters
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
ENABLE_MONITORING_TEST_ROUTE=false
# FILE_TICKET_SECRET must be server-side only and must never be exposed to browser code.
# Used to sign patient file upload tickets (HMAC-SHA256) for the Phase 5 upload flow.
# Must be independent from all other server-side credentials.
FILE_TICKET_SECRET=your-file-ticket-secret-at-least-32-characters
# Production launch gate for patient uploads. Keep 'false' until an approved
# malware scanner is configured and validated in Preview; patient request
# submission continues to work while uploads are disabled. Only 'true'/'false'
# are accepted when set.
PATIENT_UPLOADS_ENABLED=false
